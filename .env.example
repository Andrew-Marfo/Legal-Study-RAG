# ---------------------------------------------------------------------------
# Legal Study RAG — environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# On Hugging Face Spaces, set these as Repository Secrets instead.
# ---------------------------------------------------------------------------

# --- LLM (generation) -------------------------------------------------------
# Free key, no credit card: https://console.groq.com
GROQ_API_KEY=
# Groq model used for answer generation.
LLM_MODEL=llama-3.3-70b-versatile

# --- Vector store -----------------------------------------------------------
# Qdrant Cloud forever-free 1GB cluster: https://cloud.qdrant.io
# Example: https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east.aws.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=
# Collection name inside the Qdrant cluster.
QDRANT_COLLECTION=legal_study_rag

# --- Embeddings -------------------------------------------------------------
# bge-base-en-v1.5 -> 768 dims. Low-RAM fallback: sentence-transformers/all-MiniLM-L6-v2 (384 dims).
# If you change this, the Qdrant collection must be recreated with the matching vector size.
EMBED_MODEL=BAAI/bge-base-en-v1.5

# --- Local development ------------------------------------------------------
# "true" to use an embedded on-disk store instead of Qdrant Cloud (offline dev).
# Uses qdrant-client's local mode, so the code path is identical to the cloud one.
USE_LOCAL_STORE=false
# Directory for the embedded store when USE_LOCAL_STORE=true.
LOCAL_STORE_PATH=.local_store
